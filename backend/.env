# PostgreSQL connection string (required)
# Use Neon, Supabase, Railway, or any PostgreSQL provider
DATABASE_URL=postgresql://postgres:password@helium/heliumdb?sslmode=disable

# JWT secret - use a long random string (required)
JWT_SECRET=mySuperSecretKey

# Session secret (optional, for Express sessions)
SESSION_SECRET=your-session-secret-change-this

# Server port (defaults to 3001)
PORT=3001

# Allowed CORS origin - URL of your frontend
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────────────
# SMTP Email Settings (optional - if not set, OTP is printed to logs)
# ──────────────────────────────────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your-app-password    ← Generate at myaccount.google.com/apppasswords
#   SMTP_FROM=Hostel Issue Tracker <yourname@gmail.com>

# Resend.com example (recommended free tier):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx    ← API key from resend.com
#   SMTP_FROM=Hostel Issue Tracker <onboarding@resend.dev>

# Brevo / Sendinblue example:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourbrevo@email.com
#   SMTP_PASS=your-brevo-smtp-key

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hostel Issue Tracker <noreply@yourdomain.com>
